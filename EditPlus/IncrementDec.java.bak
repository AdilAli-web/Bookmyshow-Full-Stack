class IncrementDec 
{
	public static void main(String[] args) 
	{
		int a=5;
		int b=10;

		a++;
		b--;
		System.out.println(a);
		System.out.println(b);

		System.out.println("--------------------------------");
		int c=5;
		int d=++c;
		int res=c++;
		System.out.println(d);
		System.out.println(res);
		System.out.println(c);
	}
}
